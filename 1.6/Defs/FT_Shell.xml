<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ShellBase">
    <defName>FT_Shell_NuclearWarhead</defName>
    <label>nuclear warhead</label>
    <description>An industrial‑tech warhead powered by precisely calculated high explosives and refined uranium. Upon detonation, it unleashes a massive explosion accompanied by an intense electromagnetic pulse, violent shockwaves, and blinding flashes of light. Flammable objects around the impact site are ignited, and even targets outside the lethal radius may be stunned by the blast effects.\n\nCan be fired from mortars or launched by artillery. Will not detonate when damaged.\n\nBe warned: nuclear detonations may cause unpredictable and long‑lasting damage to the environment.\n\nExtremely powerful and highly controversial, these weapons see widespread use on some worlds while being strictly banned on others. Most industrial worlds claim to favor purchasing “clean” anti‑grain warheads from core worlds rather than manufacturing nuclear warheads themselves, citing environmental concerns.\nIn truth, this preference is driven by core‑world arms dealers seeking markets to offload mass‑produced anti‑grain weaponry. Unlike nuclear warheads, anti‑grain devices cannot be reverse‑engineered with industrial‑level technology.</description>
    <graphicData>
      <texPath>FT_NuclearDawn/FT_Nuke</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <tradeability>Sellable</tradeability>
    <statBases>
      <MarketValue>2500</MarketValue>
    </statBases>
    <thingSetMakerTags>
      <li>NuclearWeapon</li>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
    <projectileWhenLoaded>FT_Bullet_NuclearWarhead</projectileWhenLoaded>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>FT_Bullet_NuclearWarhead</defName>
    <label>nuclear warhead</label>
    <thingClass>Fortified.Projectile_ExplosiveByComps</thingClass>
    <graphicData>
      <texPath>FT_NuclearDawn/FT_Shell_Nuke</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <modExtensions>
      <li Class="Fortified.ModExtension_ExpolsionWithConditions">
        <conditions>
					<li>
						<conditionDef>FTND_NuclearFlare</conditionDef>
						<percent>1</percent>
						<duration>12000~24000</duration>
					</li>
					<li>
						<conditionDef>FTND_NuclearFlare</conditionDef>
						<percent>5</percent>
						<duration>7500~15000</duration>
					</li>
					<li>
						<conditionDef>FTND_NuclearFlare</conditionDef>
						<percent>25</percent>
						<duration>1250~5000</duration>
					</li>
          <li>
            <conditionDef>FTND_NuclearFallout</conditionDef>
            <percent>1</percent>
            <duration>360000</duration>
          </li>
          <li>
            <conditionDef>FTND_NuclearFallout</conditionDef>
            <percent>5</percent>
            <duration>60000~180000</duration>
          </li>
          <li>
            <conditionDef>FTND_NuclearFallout</conditionDef>
            <percent>25</percent>
            <duration>15000</duration>
          </li>
          <li>
            <conditionDef>FTND_NuclearWinter</conditionDef>
            <percent>1</percent>
            <duration>360000~960000</duration>
          </li>
          <li>
            <conditionDef>FTND_NuclearWinter</conditionDef>
            <percent>5</percent>
            <duration>60000~360000</duration>
          </li>
          <li>
            <conditionDef>FTND_Flashstorm</conditionDef>
            <percent>25</percent>
            <duration>10000~30000</duration>
          </li>
        </conditions>
      </li>
      <li Class="Fortified.ModExtension_CompositeExplosion">
        <compositeExplosions>
          <li>
            <!--核爆心-->
            <countdown>1</countdown>
            <radius>5.9</radius>
            <damamgeDef>Bomb</damamgeDef>
            <amount>500</amount>
            <armorPenetration>2</armorPenetration>
            <explosionSound>MortarBomb_Explode</explosionSound>
          </li>
          <li>
            <countdown>1</countdown>
            <radius>14.9</radius>
            <damamgeDef>EMP</damamgeDef>
            <amount>80</amount>
            <armorPenetration>2</armorPenetration>
            <explosionSound>Explosion_EMP</explosionSound>
          </li>
          <li>
            <countdown>2</countdown>
            <radius>10.9</radius>
            <damamgeDef>Flame</damamgeDef>
            <amount>80</amount>
            <armorPenetration>2</armorPenetration>
            <explosionSound>MortarBomb_Explode</explosionSound>
            <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
            <preExplosionSpawnChance>0.25</preExplosionSpawnChance>
            <preExplosionSpawnThingCount>50</preExplosionSpawnThingCount>
            <postExplosionSpawnThingDef>Filth_Fuel</postExplosionSpawnThingDef>
            <postExplosionSpawnChance>0.75</postExplosionSpawnChance>
            <postExplosionSpawnThingCount>25</postExplosionSpawnThingCount>
