<?xml version="1.0" encoding="utf-8" ?>

<Defs> 
 <ThingDef ParentName="ResourceBase">
    <defName>FT_DepletedUranium</defName>
    <label>depleted uranium</label>
    <description>A dense, dark heavy metal produced as a byproduct of uranium enrichment. Widely used in midworld military technologies, its extreme hardness and mass make it ideal for armor plating, and armor-piercing munitions.</description>
    <graphicData>
      <texPath>FT_NuclearDawn/FT_DepletedUranium</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <statBases><!--铀238占比99%多，属性和天然铀无差别-->
      <MarketValue>0.5</MarketValue><!--属于低价值废料-->
      <Mass>1</Mass>
      <StuffPower_Armor_Sharp>1.08</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.54</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.65</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.1</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.5</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>true</burnableByRecipe>
    <smeltable>true</smeltable>
    <minRewardCount>100</minRewardCount>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <appearance>Metal</appearance>
      <commonality>0.05</commonality>
      <color>(80,80,80)</color><!--暂且留着不改，反正颜色没啥影响-->
      <constructEffect>ConstructMetal</constructEffect>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <statFactors><!--铀238占比99%多，属性和天然铀无差别-->
        <MaxHitPoints>2.5</MaxHitPoints>
        <WorkToMake>1.9</WorkToMake>
        <WorkToBuild>1.9</WorkToBuild>
        <Beauty>0.5</Beauty>
        <Flammability>0.0</Flammability>
        <DoorOpenSpeed>0.75</DoorOpenSpeed>
        <MeleeWeapon_CooldownMultiplier>1.10</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>
  
  <ThingDef ParentName="ResourceBase">
    <defName>FT_UraniumOutput</defName>
    <label>separation uranium</label>
    <description>A semi-processed uranium product intended for further refinement. Can be machined on a lathe to produce enriched uranium and depleted uranium.</description>
    <graphicData>
      <texPath>FT_NuclearDawn/FT_SeparationUranium</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>5</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MarketValue>40</MarketValue>
      <Mass>1</Mass>
      <Flammability>0.0</Flammability>
    </statBases>
    <intricate>true</intricate>
    <thingCategories>
      <li>Unfinished</li>
    </thingCategories>
  </ThingDef>
  
  <RecipeDef MayRequire="Dubwise.Rimatomics">
    <defName>FT_Make_RA_SplitUranium</defName>
    <label>Split uranium for Rimatomics company</label>
    <description>Separate the uranium into enriched uranium and depleted uranium while adhering to Rimatomics standards.</description>
    <jobString>Spliting uranium.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>7500</workAmount>
    <recipeUsers>
      <li>FT_TableLathe</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>FT_UraniumOutput</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>FT_UraniumOutput</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Plutonium>1</Plutonium>
      <DepletedUraniumPellets>24</DepletedUraniumPellets>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
	<researchPrerequisite>FT_NuclearDawn</researchPrerequisite>
    <workSkill>Crafting</workSkill>
  </RecipeDef>
  
  <RecipeDef>
    <defName>FT_Make_SplitUranium</defName>
    <label>Split uranium</label>
    <description>Split and refine semi-processed uraniun product into enriched uranium and depleted uranium.</description>
    <jobString>Spliting uranium.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>5000</workAmount>
    <recipeUsers>
      <li>FT_TableLathe</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>FT_UraniumOutput</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>FT_UraniumOutput</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <FT_EnrichedUranium>1</FT_EnrichedUranium>
      <FT_DepletedUranium>99</FT_DepletedUranium><!--铀238含量99%多-->
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
	<researchPrerequisite>FT_NuclearDawn</researchPrerequisite>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

  <ThingDef ParentName="ResourceBase">
    <defName>FT_EnrichedUranium</defName>
    <label>enriched uranium</label>
    <description>A highly enriched weapons-grade uranium that can be used for fission-type nuclear warhead, a weapon commonly used in midworlds, comparable to an antigrain warhead.</description>
    <graphicData>
      <texPath>FT_NuclearDawn/FT_EnrichedUranium</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <tickerType>Never</tickerType>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MarketValue>1200</MarketValue>
      <Mass>2</Mass>
      <Flammability>0.0</Flammability>
    </statBases>
    <intricate>true</intricate>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>FT_MOX</defName>
    <label>MOX fuel</label>
    <description>Mixed oxide fuel, commonly referred to as MOX fuel, is nuclear fuel that contains more than one oxide of fissile material, usually consisting of plutonium blended with natural uranium.</description>
    <graphicData>
      <texPath>FT_NuclearDawn/FT_EnrichedUranium</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <tickerType>Never</tickerType>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>2</Mass>
      <Flammability>0.0</Flammability>
    </statBases>
    <intricate>true</intricate>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
</Defs>	