<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<XmlExtensions.SettingsMenuDef>
		<defName>FTND_SettingMenu</defName>
		<modId>Aoba.Fortress.Industrial.NuclearDawn</modId>
		<label>Fortification - Nuclear Dawn</label>
		<settings>
			<li Class="XmlExtensions.Setting.Text">
				<text>All changes needs a restart to apply!</text>
				<anchor>Middle</anchor>
			</li>
			<li Class="XmlExtensions.Setting.Checkbox">
				<key>RemoveNuclearLauncher</key>
				<label>Remove nuclear launcher</label>
				<defaultValue>false</defaultValue>
			</li>
			<li Class="XmlExtensions.Setting.Text">
				<text>Only removes the nuclear launcher. Nuclear shells still remain.</text>
				<anchor>Left</anchor>
			</li>
			<li Class="XmlExtensions.Setting.Checkbox">
				<key>AdjustNuclearExplosion</key>
				<label>Nerf nuclear weapons aftermath effects</label>
				<defaultValue>false</defaultValue>
			</li>	
			<li Class="XmlExtensions.Setting.Text">
				<text>Lessens the adverse effects caused by nuclear explosions.</text>
				<anchor>Left</anchor>
			</li>

		</settings>
	</XmlExtensions.SettingsMenuDef>
</Defs>